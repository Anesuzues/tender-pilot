# ---------------------------------------------------------------------------
# Environment variables to set in the Vercel dashboard
# (Project → Settings → Environment Variables). These override the safe local
# defaults for the serverless runtime.
# ---------------------------------------------------------------------------

# --- Required: managed Postgres (SQLite cannot persist on Vercel) ---
# Use a POOLED connection string (Supabase port 6543 / Neon pooled endpoint).
# Note the +asyncpg driver and sslmode.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:6543/DB?sslmode=require

# --- Required: serverless behavior ---
ENVIRONMENT=production
DB_USE_NULL_POOL=true        # don't reuse pooled connections across invocations
INGEST_INLINE_SYNC=true      # process PDFs within the request (no background workers)
AUTO_CREATE_DB=false         # run `python -m app.initdb` once instead (see README)

# --- Required: a strong secret (generate: openssl rand -hex 32) ---
SECRET_KEY=replace-with-64-hex-chars

# --- Required: where to allow browser requests from (your frontend origin) ---
# Comma-separated. Avoid "*" in production.
CORS_ORIGINS=["https://your-frontend.vercel.app"]

# --- Storage: local disk is read-only on Vercel. Use Supabase for persistence ---
STORAGE_BACKEND=supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_BUCKET=tenderpilot
# (If you skip Supabase, set STORAGE_DIR=/tmp/storage — uploads work for the
#  single request that ingests them but are NOT persisted across invocations.)

# --- AI: optional. Without keys the deterministic offline stub is used ---
LLM_PROVIDER=stub            # set to anthropic | openai to enable real AI
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
EMBEDDING_PROVIDER=local     # set to openai (+ OPENAI_API_KEY) for semantic search
