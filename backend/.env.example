# ---------------------------------------------------------------------------
# TenderPilot AI — backend environment.
# Copy to `.env`. Every value has a working default; nothing here is REQUIRED to
# run locally. Fill the marked sections to enable production capabilities.
# ---------------------------------------------------------------------------

# --- App ---
ENVIRONMENT=development
DEBUG=true
APP_NAME=TenderPilot AI

# --- Security (CHANGE in production: openssl rand -hex 32) ---
SECRET_KEY=dev-insecure-change-me-please-0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
# Dev default = local SQLite. For production use PostgreSQL + pgvector:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/tenderpilot
DATABASE_URL=sqlite+aiosqlite:///./tenderpilot.db

# --- Storage ---
# local | supabase
STORAGE_BACKEND=local
STORAGE_DIR=./storage
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=tenderpilot

# --- AI / RAG ---
# llm_provider: stub (offline, no key) | anthropic | openai
LLM_PROVIDER=stub
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
LLM_MODEL=claude-sonnet-4-6
# embedding_provider: local (offline) | openai
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small

# --- Queue (optional, production) ---
# REDIS_URL=redis://localhost:6379/0
CELERY_EAGER=true

# --- Uploads ---
MAX_UPLOAD_MB=50
